SECRET_KEY=change-this-secret-key

# Local MongoDB:
# MONGO_URI=mongodb://localhost:27017/earthscape
# MongoDB Atlas (cloud) -- copy the connection string from Atlas > Connect,
# swap <db_password> for the database user's real password, and keep a
# database name (e.g. /earthscape) before the "?":
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/earthscape?retryWrites=true&w=majority

FLASK_ENV=development

# Gmail SMTP for password-reset emails. Leave both blank to skip real email
# sending -- the reset link will be printed to the server console/log instead.
# 1. Enable 2-Step Verification on the Gmail account: myaccount.google.com/security
# 2. Generate an App Password: myaccount.google.com/apppasswords
# 3. Paste the 16-character app password below (NOT your regular Gmail password).
GMAIL_USER=
GMAIL_APP_PASSWORD=
